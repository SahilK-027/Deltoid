<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Saving a backup into the shared Downloads folder. From Android 10 the
         MediaStore collection needs no permission at all, so this is declared
         only for the versions where the public Downloads directory is still a
         real path we write to directly. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The rest alert is an alarm handed to the OS, not a timer inside the
         app: a Dart timer is frozen the moment Android suspends the process,
         so the tone only played when the phone was picked back up. Both spellings
         of the permission are declared: this is an alarm-clock use, so from
         API 33 USE_EXACT_ALARM is granted without sending anyone to a settings
         screen, and below that it is the only one the OS recognises. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- USE_EXACT_ALARM above was added in API 33. On Android 12 the OS has
         never heard of it, so an app declaring only that one is refused exact
         alarms outright — `canScheduleExactAlarms()` is false, the plugin
         throws, and the rest alert is never scheduled at all. This is the
         same permission for API 31 and 32, where it is granted at install. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- So a rest scheduled before a reboot is put back afterwards. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The session line is a foreground service for exactly one reason: a
         progress bar has no clock of its own. It shows whatever value was last
         posted, and Android freezes an ordinary app within seconds of the
         screen going off — so a rest bar draining towards zero would stop
         where it was and sit there while the rest ran out underneath it. A
         foreground service is not frozen, so the second it counts is a second
         this app is awake to draw. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Cloud backup, and nothing else — see SYNC.md. Declared here rather than
         relied on, because the only other declaration is in the *debug*
         manifest, which Flutter injects for hot reload and the tooling's own
         connection to a running app. Every debug build therefore has network
         and no release build does, which is the worst shape a permission bug
         can take: it cannot be reproduced on the build you develop on, and on
         the build that ships every request fails with a SocketException that
         reads like a server that is down. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="${appName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The service behind the session line. `specialUse` rather than
             `health`: the semantically correct type demands ACTIVITY_RECOGNITION
             or BODY_SENSORS be granted at runtime, and this reads no sensor —
             it counts a rest. The justification `specialUse` asks for is a Play
             requirement, and this app is not distributed there.

             Stopped with the task on purpose: a workout swiped out of recents
             is one nobody is in, and the line it left behind used to be
             undismissable, because `clear` never runs down that path. -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Counting the rest between sets of a workout the user is in" />
        </service>
        <!-- The plugin's own receivers. Without these a scheduled rest alert
             is accepted and then never shown. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
