<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LaunchTheme is not restated: its colour and mark are night-qualified
         resources, so the single definition in values/ resolves correctly in
         dark mode. Only the post-splash window needs a dark parent. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
