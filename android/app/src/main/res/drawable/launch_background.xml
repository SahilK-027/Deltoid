<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-31 launch window. Android 12+ ignores this and uses the SplashScreen
     API attributes in values-v31/styles.xml instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_mark" />
    </item>
</layer-list>
