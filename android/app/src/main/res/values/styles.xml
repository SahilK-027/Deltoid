<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window, and the only place the mark is drawn. Parented on
         Theme.SplashScreen so androidx.core:core-splashscreen owns it on every
         API level: below 31 it emulates the platform splash rather than
         falling back to a windowBackground bitmap, which is what used to draw
         the mark at a different size on older phones.

         The system masks the icon to a 192dp circle on a 288dp canvas, which
         is what the art is sized to — its ink spans 52% of the canvas. Colour
         and mark are both night-qualified, so this style is stated once and
         resolves per mode.

         MainActivity holds this on screen until Dart reports boot done. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <!-- Behind the Flutter UI once the splash lifts. Never seen on its own now
         that the splash is held through boot, but it carries the app's
         background colour rather than the platform default so a transparent
         frame or a resize can't flash white. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- Load-bearing, not decoration. Removing the platform splash applies
             this theme to the window, and that application overwrites the bar
             appearance Flutter had already set: without these the status bar
             kept white icons over the light theme's white background, and read
             as blank. Stated per mode so what the splash restores is right in
             both. `_ReadyState._reassertOverlay` covers the rest — the theme
             follows the system's night setting, the app's does not have to. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
