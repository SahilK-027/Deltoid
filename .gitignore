migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Not only the root one. `flutter build` also writes android/build/, and
# android/build/reports/problems/problems-report.html was tracked there — so
# every build dirtied the working tree with a generated file.
**/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flutter's iOS generated config. The plain `ephemeral/` is the real one; the
# glob catches the "ephemeral 2" copies file sync leaves behind, which showed
# up staged once already.
**/ios/Flutter/ephemeral*/

# Databases pulled off the device for inspection. An audit ran `adb ... cat
# deltoid.sqlite` into the working tree and the result reached the index.
*.sqlite
*.sqlite-wal
*.sqlite-shm

# The live project's URL, publishable key and OAuth client id.
#
# None of the three is a secret — all of them ship inside the APK and are
# extractable from it, which is exactly why RLS rather than a key is what
# protects the data (SYNC.md § 3). They are kept out of the tree as hygiene: a
# live project reference in a public repo is an invitation to probe it, and a
# free project that gets hammered is a sync outage on the phone.
#
# `deltoid.env.example.json` is committed and shows the shape.
deltoid.env.json
